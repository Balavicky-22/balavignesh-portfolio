# ===================================================================
# Balavignesh B — Portfolio Backend Environment Variables
# Copy this file to .env for local development or set in Render Environment
# ===================================================================

# JWT Security Key (Set a random 32+ character string in production)
SECRET_KEY=balavignesh-ai-portfolio-jwt-secret-key-2026-production-grade
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Default Admin Credentials (initialized on first launch)
ADMIN_EMAIL=admin@balavignesh.dev
ADMIN_PASSWORD=Balavignesh@2026

# Database Configuration
# Local SQLite:
DATABASE_URL=sqlite+aiosqlite:///./portfolio.db
# Production PostgreSQL (Render automatically provides DATABASE_URL):
# DATABASE_URL=postgresql+asyncpg://user:password@dpg-xxxx.render.com/portfolio_db

# CORS Allowed Origins (comma-separated or * for development)
# For production, include your deployed Vercel domains:
CORS_ORIGINS=http://localhost:3000,http://localhost:5500,http://127.0.0.1:3000,http://127.0.0.1:5500,https://balavignesh.vercel.app,https://balavignesh-admin.vercel.app,*

# Upload Directory
UPLOAD_DIR=uploads
